  "voices": {
   "bf_emma": 3.82,
   "bf_isabella": 4.03,
   "bf_alice": 4.27,
   "bf_lily": 4.25,
   "bm_george": 4.77,
   "bm_fable": 4.68,
   "bm_lewis": 4.69,
   "bm_daniel": 4.15
  }
 },
 "a521d429": {
  "text": "Candle Loft sells scented candles on the high street, so pop in.",
  "role": "dj",
  "voices": {
   "bf_emma": 3.63,
   "bf_isabella": 3.76,
   "bf_alice": 3.84,
   "bf_lily": 3.82,
   "bm_george": 4.35,
   "bm_fable": 4.37,
   "bm_lewis": 4.15,
   "bm_daniel": 3.76
  }
 },
 "eebeb7e6": {
  "text": "Sun Cup Cafe serves coffee and cakes, open for breakfast, so pop in.",
  "role": "dj",
  "voices": {
   "bf_emma": 4.19,
   "bf_isabella": 4.26,
   "bf_alice": 4.46,
   "bf_lily": 4.31,
   "bm_george": 4.91,
   "bm_fable": 4.77,
   "bm_lewis": 4.69,
   "bm_daniel": 4.26
  }
 },
 "91c9d15a": {
  "text": "Maple Mug serves tea and toast, open mornings, so pop in.",
  "role": "dj",
  "voices": {
