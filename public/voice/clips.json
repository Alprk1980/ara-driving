  "voices": {
   "bf_emma": 3.41,
   "bf_isabella": 3.52,
   "bf_alice": 3.61,
   "bf_lily": 3.55,
   "bm_george": 4.15,
   "bm_fable": 4.12,
   "bm_lewis": 3.89,
   "bm_daniel": 3.55
  }
 },
