   "bf_emma": 2.31,
   "bf_isabella": 2.36,
   "bf_alice": 2.51,
   "bf_lily": 2.68,
   "bm_lewis": 2.73,
   "bm_daniel": 2.54
  }
 },
 "aeedad39": {
  "text": "The pump's waiting, so keep your tank happy.",
  "role": "dj",
  "voices": {
   "bm_george": 2.77,
   "bm_fable": 3.04,
   "bf_emma": 2.36,
   "bf_isabella": 2.38,
   "bf_alice": 2.55,
   "bf_lily": 2.63,
   "bm_lewis": 2.68,
   "bm_daniel": 2.45
  }
 },
 "082996d1": {
  "text": "Don't run out, driver, there's fuel just ahead.",
  "role": "dj",
  "voices": {
   "bm_george": 3.12,
   "bm_fable": 3.12,
   "bf_emma": 2.45,
   "bf_isabella": 2.62,
   "bf_alice": 2.79,
   "bf_lily": 2.91,
   "bm_lewis": 3.11,
   "bm_daniel": 2.73
  }
 },
 "7c255ba1": {
  "text": "You'll need petrol, and the pump's by the bus stop.",
  "role": "dj",
  "voices": {
   "bm_george": 3.02,
   "bm_fable": 3.11,
   "bf_emma": 2.47,
   "bf_isabella": 2.56,
   "bf_alice": 2.63,
   "bf_lily": 2.67,
   "bm_lewis": 2.83,
   "bm_daniel": 2.61
  }
 },
 "922ff6e8": {
  "text": "You're on a lovely streak, keep that roll going.",
  "role": "dj",
  "voices": {
   "bm_george": 3.02,
   "bm_fable": 3.1,
   "bf_emma": 2.49,
   "bf_isabella": 2.52,
   "bf_alice": 2.66,
   "bf_lily": 2.79,
   "bm_lewis": 2.87,
   "bm_daniel": 2.54
  }
 },
 "ffa05071": {
  "text": "You've nailed them in a row, that's great.",
  "role": "dj",
  "voices": {
   "bm_george": 2.66,
   "bm_fable": 2.7,
   "bf_emma": 2.12,
   "bf_isabella": 2.11,
   "bf_alice": 2.32,
   "bf_lily": 2.42,
   "bm_lewis": 2.23,
   "bm_daniel": 2.26
  }
 },
 "2a006842": {
  "text": "That shift's gone like a breeze, driver.",
  "role": "dj",
  "voices": {
   "bm_george": 2.69,
   "bm_fable": 2.89,
   "bf_emma": 2.2,
   "bf_isabella": 2.23,
   "bf_alice": 2.4,
   "bf_lily": 2.42,
   "bm_lewis": 2.45,
   "bm_daniel": 2.33
  }
 },
 "48c5e63c": {
  "text": "Here's another, you're building a proper streak.",
  "role": "dj",
  "voices": {
   "bm_george": 2.87,
   "bm_fable": 2.87,
   "bf_emma": 2.28,
   "bf_isabella": 2.27,
   "bf_alice": 2.51,
   "bf_lily": 2.66,
   "bm_lewis": 2.64,
   "bm_daniel": 2.43
  }
 },
 "5c42c93a": {
  "text": "Streak's climbing, and we've got more jobs coming up.",
  "role": "dj",
  "voices": {
   "bm_george": 3.21,
   "bm_fable": 3.18,
   "bf_emma": 2.66,
   "bf_isabella": 2.71,
   "bf_alice": 2.87,
   "bf_lily": 3,
   "bm_lewis": 3.17,
   "bm_daniel": 2.8
  }
 },
 "e9440355": {
  "text": "The roadworks are here, so cones guide you to a clever detour.",
  "role": "dj",
  "voices": {
   "bm_george": 3.91,
   "bm_fable": 3.99,
   "bf_emma": 3.42,
   "bf_isabella": 3.51,
   "bf_alice": 3.56,
   "bf_lily": 3.59,
   "bm_lewis": 3.86,
   "bm_daniel": 3.45
  }
 },
 "27ebff97": {
  "text": "A friendly digger is digging, so please take the detour.",
  "role": "dj",
  "voices": {
   "bm_george": 3.68,
   "bm_fable": 3.64,
   "bf_emma": 3.02,
   "bf_isabella": 3.24,
   "bf_alice": 3.07,
   "bf_lily": 3.2,
   "bm_lewis": 3.45,
   "bm_daniel": 3.07
  }
 },
 "6b9af901": {
  "text": "Cone cones on road, the works are slow and silly.",
  "role": "dj",
  "voices": {
   "bm_george": 3.5,
   "bm_fable": 3.4,
   "bf_emma": 2.79,
   "bf_isabella": 2.84,
   "bf_alice": 2.98,
   "bf_lily": 2.99,
   "bm_lewis": 3.28,
   "bm_daniel": 2.95
  }
 },
 "dacd91d2": {
  "text": "The road works are busy, so find a detour with cheerful cones.",
  "role": "dj",
  "voices": {
   "bm_george": 4.11,
   "bm_fable": 4.03,
   "bf_emma": 3.55,
   "bf_isabella": 3.6,
   "bf_alice": 3.77,
   "bf_lily": 3.7,
   "bm_lewis": 3.86,
   "bm_daniel": 3.59
  }
 },
 "dbdd05a3": {
  "text": "This road is digging slowly, but the detour is easy peasy.",
  "role": "dj",
  "voices": {
   "bm_george": 4.05,
   "bm_fable": 3.87,
   "bf_emma": 3.44,
   "bf_isabella": 3.65,
   "bf_alice": 3.6,
   "bf_lily": 3.53,
   "bm_lewis": 3.92,
   "bm_daniel": 3.55
  }
 },
 "30c55dbc": {
  "text": "A parade with a float is marching, and the band plays!",
  "role": "dj",
  "voices": {
   "bm_george": 3.73,
   "bm_fable": 3.48,
   "bf_emma": 2.94,
   "bf_isabella": 2.98,
   "bf_alice": 3.12,
   "bf_lily": 3.21,
   "bm_lewis": 3.48,
   "bm_daniel": 3.14
  }
 },
 "9ca0b316": {
  "text": "The parade band is marching, so wave at the float.",
  "role": "dj",
  "voices": {
   "bm_george": 3.59,
   "bm_fable": 3.57,
   "bf_emma": 3.05,
   "bf_isabella": 3.09,
   "bf_alice": 3.19,
   "bf_lily": 3.08,
   "bm_lewis": 3.38,
   "bm_daniel": 3
  }
 },
 "77119fb6": {
  "text": "A slow parade is on this road, with a float and band.",
  "role": "dj",
  "voices": {
   "bm_george": 3.86,
   "bm_fable": 3.62,
   "bf_emma": 2.97,
   "bf_isabella": 3.06,
   "bf_alice": 3.13,
   "bf_lily": 3.18,
   "bm_lewis": 3.65,
   "bm_daniel": 3.1
  }
 },
 "f7c3a80d": {
  "text": "The march parade is cheerful, and the band plays softly.",
  "role": "dj",
  "voices": {
   "bm_george": 3.76,
   "bm_fable": 3.75,
   "bf_emma": 3.15,
   "bf_isabella": 3.32,
   "bf_alice": 3.29,
   "bf_lily": 3.27,
   "bm_lewis": 3.46,
   "bm_daniel": 3.2
  }
 },
 "f128e693": {
  "text": "The shop sale is on, and every shop wants a delivery!",
  "role": "dj",
  "voices": {
   "bm_george": 3.55,
   "bm_fable": 3.55,
   "bf_emma": 3.04,
   "bf_isabella": 3.17,
   "bf_alice": 3.21,
   "bf_lily": 3.28,
   "bm_lewis": 3.35,
   "bm_daniel": 3.12
  }
 },
 "eca1577b": {
  "text": "The cake fair is on, and every cafe wants a delivery!",
  "role": "dj",
  "voices": {
   "bm_george": 3.73,
   "bm_fable": 3.62,
   "bf_emma": 2.99,
   "bf_isabella": 3.09,
   "bf_alice": 3.3,
   "bf_lily": 3.38,
   "bm_lewis": 3.55,
   "bm_daniel": 3.23
  }
 },
 "3136c548": {
  "text": "The park festival is bright, and stalls need fresh treats!",
  "role": "dj",
  "voices": {
   "bm_george": 3.72,
   "bm_fable": 3.77,
   "bf_emma": 3.17,
   "bf_isabella": 3.31,
   "bf_alice": 3.38,
   "bf_lily": 3.33,
   "bm_lewis": 3.59,
   "bm_daniel": 3.27
  }
 },
 "a3099297": {
  "text": "The market day is buzzing, and stalls cheer for you!",
  "role": "dj",
  "voices": {
   "bm_george": 3.31,
   "bm_fable": 3.3,
   "bf_emma": 2.5,
   "bf_isabella": 2.51,
   "bf_alice": 2.82,
   "bf_lily": 2.88,
   "bm_lewis": 2.95,
   "bm_daniel": 2.81
  }
 },
 "bede8df9": {
  "text": "The office sale is cheerful, and desks want little parcels!",
  "role": "dj",
  "voices": {
   "bm_george": 3.87,
   "bm_fable": 4.04,
   "bf_emma": 3.32,
   "bf_isabella": 3.56,
   "bf_alice": 3.49,
   "bf_lily": 3.46,
   "bm_lewis": 3.77,
   "bm_daniel": 3.39
  }
 },
 "05f6228a": {
  "text": "The clinic fair is calm, and baskets need soft deliveries!",
  "role": "dj",
  "voices": {
   "bm_george": 3.99,
   "bm_fable": 3.91,
   "bf_emma": 3.25,
   "bf_isabella": 3.42,
   "bf_alice": 3.5,
   "bf_lily": 3.49,
   "bm_lewis": 3.85,
   "bm_daniel": 3.45
  }
 },
 "a655237b": {
  "text": "The library book sale is fun, and shelves need tidy boxes!",
  "role": "dj",
  "voices": {
   "bm_george": 4.03,
   "bm_fable": 4.14,
   "bf_emma": 3.63,
   "bf_isabella": 3.72,
   "bf_alice": 3.76,
   "bf_lily": 3.75,
   "bm_lewis": 3.96,
   "bm_daniel": 3.65
  }
 },
 "cac4fa92": {
  "text": "Lovely ride, this. Nice and smooth.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.21
  }
 },
 "868590b2": {
  "text": "Quiet day for it, isn't it?",
  "role": "rider",
  "voices": {
   "bm_fable": 2.22
  }
 },
 "6de6b9a5": {
  "text": "No rush at all, is there?",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.65
  }
 },
 "ef59118c": {
  "text": "Rather easy going, isn't it?",
  "role": "rider",
  "voices": {
   "bm_fable": 2.38
  }
 },
 "c6df426e": {
  "text": "Good pace, actually. Very comfortable.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.37
  }
 },
 "ebcedd6f": {
  "text": "Just right, this. Not bad at all.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.52
  }
 },
 "b3daede4": {
  "text": "Might warm up a bit, mind.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.62
  }
 },
 "b6caa581": {
  "text": "Smooth as anything, this ride.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.46
  }
 },
 "0d7fc86c": {
  "text": "Gently now, eh. Gently.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.77
  }
 },
 "eb04181d": {
  "text": "I'm going a bit tense.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.11
  }
 },
 "c1e8aaac": {
  "text": "Not ideal, that.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.44
  }
 },
 "4c475589": {
  "text": "Mind the wobble, please.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.13
  }
 },
 "59cf493c": {
  "text": "Ah, yes, a bit wobbly.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.6
  }
 },
 "b973f31e": {
  "text": "A bit shaky, that.",
  "role": "rider",
  "voices": {
   "bm_fable": 1.93
  }
 },
 "c0036a1d": {
  "text": "Let's take it gently.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.54
  }
 },
 "8eb72678": {
  "text": "Steady on, please.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.04
  }
 },
 "9bf7065c": {
  "text": "I liked that. Ta very much.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.86
  }
 },
 "192b1ae0": {
  "text": "You're a star. Lovely ride.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.32
  }
 },
 "eb72ab56": {
  "text": "Cheers for that. Spot on.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.7
  }
 },
 "2af5262e": {
  "text": "Not bad at all, that.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.04
  }
 },
 "ad5b7b52": {
  "text": "Thanks kindly. I'm grateful.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.82
  }
 },
 "3bd7e480": {
  "text": "Lovely lift. Ta again.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.34
  }
 },
 "46e20991": {
  "text": "A bit wild, wasn't it?",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.67
  }
 },
 "5b8b0007": {
  "text": "I've lost a sock.",
  "role": "rider",
  "voices": {
   "bm_fable": 1.7
  }
 },
 "48dd06b1": {
  "text": "Rough ride, that. Still, cheers.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.04
  }
 },
 "9d2b708e": {
  "text": "Need a cuppa after that.",
  "role": "rider",
  "voices": {
   "bm_fable": 1.86
  }
 },
 "d4501e8f": {
  "text": "I'm a little shaken.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.38
  }
 },
 "60c3419e": {
  "text": "Not ideal, that ride.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.24
  }
 },
 "c839eb53": {
  "text": "Ta for this. It's quite bright, isn't it?",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.18
  }
 },
 "4398a415": {
  "text": "Cheers! Bit mild for the season, isn't it?",
  "role": "rider",
  "voices": {
   "bm_fable": 3.08
  }
 },
 "24fa9848": {
  "text": "Hi! Not bad outside, all things considered.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.59
  }
 },
 "87168cb3": {
  "text": "Brr! It's got a bit of bite, hasn't it?",
  "role": "rider",
  "voices": {
   "bm_fable": 2.92
  }
 },
 "8c7ce363": {
  "text": "Hello! You can't see much today, can you?",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.24
  }
 },
 "1aa9b2cb": {
  "text": "Hello! Windy one, this. Hope you're not in a rush.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.98
  }
 },
 "2c979095": {
  "text": "Thanks for this. Lovely to get out of the wind.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.43
  }
 },
 "964447da": {
  "text": "Oof! That was a bit of a bump.",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.82
  }
 },
 "8527f907": {
  "text": "Gosh, that jolted me quite nicely.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.86
  }
 },
 "5735abca": {
  "text": "Cor, that was more than I bargained for.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.09
  }
 },
 "e6cf4f41": {
  "text": "Whoa! That was a bit lively, that.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.51
  }
 },
 "ee1d0179": {
  "text": "Oy! That was a bit more than I expected.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.23
  }
 },
 "0a3ab165": {
  "text": "Blimey, I felt that one in my teeth.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.75
  }
 },
 "4d180002": {
  "text": "Ugh, that was a proper knock, wasn't it?",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.15
  }
 },
 "8ba8c7b4": {
  "text": "Eh, that wasn't exactly smooth sailing.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.88
  }
 },
 "19fbdf32": {
  "text": "Whoa, that stopped us quite suddenly.",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.04
  }
 },
 "4d763184": {
  "text": "Oof, I nearly had my chin in my lap.",
  "role": "rider",
  "voices": {
   "bm_fable": 2.84
  }
 },
 "3e4756ab": {
  "text": "Blimey, that was abrupt, wasn't it?",
  "role": "rider",
  "voices": {
   "bf_isabella": 1.98
  }
 },
 "4309a5d0": {
  "text": "Goodness, we've come up short, haven't we?",
  "role": "rider",
  "voices": {
   "bm_fable": 2.67
  }
 },
 "ba80adbd": {
  "text": "Oomph! That was a bit sudden, isn't it?",
  "role": "rider",
  "voices": {
   "bf_isabella": 2.11
  }
 },
 "225718ec": {
  "text": "Ah, there. That'll wake the neighbours, that will.",
  "role": "rider",
  "voices": {
   "bm_fable": 3.02
  }
 },
 "0575a057": {
  "text": "Bus stopping now",
  "role": "guide",
  "voices": {
   "bf_emma": 1.27,
   "bf_isabella": 1.45,
   "bf_alice": 1.48,
   "bf_lily": 1.51,
   "bm_george": 1.55,
   "bm_fable": 1.5,
   "bm_lewis": 1.29,
   "bm_daniel": 1.37
  }
 },
 "8841fc9e": {
