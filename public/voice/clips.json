   "bf_emma": 3.94,
   "bf_isabella": 4.09,
   "bf_alice": 4.17,
   "bf_lily": 4.15,
   "bm_george": 4.74,
   "bm_fable": 4.45,
   "bm_lewis": 4.33,
   "bm_daniel": 3.97
  }
 },
 "5663c94b": {
