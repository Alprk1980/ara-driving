  "role": "dj",
  "voices": {
   "bf_emma": 4.1,
   "bf_isabella": 4.23,
   "bf_alice": 4.25,
   "bf_lily": 4.12,
   "bm_george": 4.88,
   "bm_fable": 4.71,
   "bm_lewis": 4.51,
   "bm_daniel": 4.2
  }
 },
